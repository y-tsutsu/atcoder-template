-            raise e
+        """Fetch a statement, retrying transient errors up to two times."""
+        url = problem.get_url()
+        retry_statuses = {429, 500, 502, 503, 504}
+        for attempt in range(1, 4):
+            resp = None
+            try:
+                resp = self._request(url, timeout=(10, 30))
+                if resp.headers.get("cf-mitigated") == "challenge":
+                    raise CaptchaError("CAPTCHA detected: {}".format(url))
+                resp.raise_for_status()
+                return ProblemContent.from_html(resp.text)
+            except (requests.ConnectionError, requests.Timeout,
+                    requests.exceptions.ChunkedEncodingError,
+                    requests.HTTPError, InputFormatDetectionError,
+                    SampleDetectionError) as error:
+                if (isinstance(error, requests.HTTPError)
+                        and resp.status_code not in retry_statuses):
+                    raise
+                details = "url={}".format(url)
+                delay = 2 ** attempt
+                if resp is not None:
+                    soup = BeautifulSoup(resp.text, "html.parser")
+                    title = (" ".join(soup.title.get_text().split())[:200]
+                             if soup.title else "<no title>")
+                    details += ", status={}, final_url={}, title={!r}".format(
+                        resp.status_code, resp.url, title)
+                    retry_after = resp.headers.get("Retry-After", "")
+                    if resp.status_code in retry_statuses and retry_after:
+                        try:
+                            seconds = float(retry_after)
+                        except ValueError:
+                            try:
+                                seconds = (parsedate_to_datetime(retry_after)
+                                           .timestamp() - time.time())
+                            except (ValueError, TypeError, OverflowError):
+                                seconds = 0
+                        delay = max(delay, seconds)
+                # Respect Retry-After without waiting indefinitely.
+                if attempt == 3 or delay > 60:
+                    if delay > 60:
+                        details += ", Retry-After exceeds 60-second wait limit"
+                    error.args = ("{} (attempts={}; {})".format(
+                        str(error) or type(error).__name__, attempt, details),)
+                    raise
+                logger.warning(
+                    "Failed to fetch problem (%s; %s). "
+                    "Retrying in %s seconds (attempt %s/3).",
+                    type(error).__name__, details, delay, attempt)
+                time.sleep(delay)
 
